# Application settings. Copy to .env (untracked) and fill in. Placeholders only in this file.

# Port the app listens on, and the address compose publishes it on.
PORT=8790
BIND_ADDR=127.0.0.1

# Cloudflare Access: the app verifies the Cf-Access-Jwt-Assertion header against this team and audience.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=<audience-tag>

# Who may sign in: email:user pairs. User ids are lowercase letters, digits and underscores.
USERS=first@example.com:user_a,second@example.com:user_b

# Absolute path outside this repository. Bind-mounted at the same path on the host and in the container.
DATA_DIR=/path/to/data
# Directory that holds the gateway socket (gateway.sock), bind-mounted as a directory.
GATEWAY_SOCKET_DIR=/path/to/gateway-socket
# Container user, must own DATA_DIR/users on the host.
APP_UID=1000
APP_GID=1000

# Apollo's per-user memory root as the host-side runner sees it. Only used to name the user's folder in the prompt.
APOLLO_MEMORY_ROOT=/path/to/agent-memory/apollo

# IANA time zone used to name new chats by date.
TZ_NAME=UTC

# Limits (defaults shown).
RUN_TIMEOUT_MS=300000
MAX_RUNS=2
RATE_LIMIT_PER_HOUR=30
PHOTO_TTL_HOURS=24
REPLAY_TURNS=20
# Phrases that count as a coaching trigger for the day-file check (comma separated; a message with photos always counts).
TRIGGER_PHRASES=good morning,workout complete,food log,weekly wrap up,recalibrate,analyze this
# Remove trailing "mail:" / "temp:" housekeeping lines from replies (set 0 to keep them).
STRIP_TRAILER_LINES=1

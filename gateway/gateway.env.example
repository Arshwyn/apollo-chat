# Environment for the host-side gateway unit. Copy to a file outside the repository (mode 0600).
# Same absolute paths as the app's .env.
DATA_DIR=/path/to/data
SOCKET_DIR=/path/to/gateway-socket
# The claude CLI the gateway launches.
CLAUDE_BIN=/path/to/claude
# Per user: the connector tool prefixes that user's runs may use. Everything else is denied.
GATEWAY_USERS={"user_a":["mcp__<connector-for-user-a>","mcp__<shared-connector>"],"user_b":["mcp__<connector-for-user-b>"]}
# Apollo memory root on this host (read only, used for the day-file check).
APOLLO_MEMORY_ROOT=/path/to/agent-memory/apollo
RUN_TIMEOUT_MS=300000
# Optional: close a connection that has not sent a complete request line within this time (default 10000).
# REQUEST_TIMEOUT_MS=10000
MAX_RUNS=2
